# =============================================================================
# HR Policy Chatbot - Environment Variables Template
# =============================================================================
# SETUP INSTRUCTIONS:
#   1. Copy this file:  copy .env.example .env
#   2. Fill in your real values below
#   3. Never commit the .env file to Git!

# --- OpenAI ---
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-YOUR_KEY_HERE
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Google Drive ---
# Download credentials.json from Google Cloud Console
# See README.md for step-by-step instructions
GOOGLE_DRIVE_CREDENTIALS_PATH=credentials.json
GOOGLE_DRIVE_FOLDER_NAME=HR Policies

# --- Database ---
DATABASE_URL=sqlite:///./hr_policies.db

# --- App Settings ---
APP_NAME=HR Policy Chatbot
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8005

# --- RAG Settings ---
TOP_K_RESULTS=5
CHUNK_SIZE=500
CHUNK_OVERLAP=50
MIN_CONFIDENCE_SCORE=0.3
MAX_CONTEXT_TOKENS=4000

# --- CORS ---
ALLOWED_ORIGINS=*
